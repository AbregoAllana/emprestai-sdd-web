{
  "openapi": "3.0.3",
  "info": {
    "title": "emprestAI — Prática SDD",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/equipment": {
      "get": {
        "operationId": "getEquipment",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogEquipment"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sessão inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/loans/{equipmentId}": {
      "post": {
        "operationId": "createLoan",
        "responses": {
          "201": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedLoan"
                }
              }
            }
          },
          "400": {
            "description": "Identificador inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Sessão inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Solicitação recusada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "equipmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/v1/loans/mine": {
      "get": {
        "operationId": "listMyOpenLoans",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OpenLoan"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sessão inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogEquipment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "NOTEBOOK",
              "MONITOR",
              "CABLE",
              "CAMERA",
              "ACCESSORY"
            ]
          },
          "assetTag": {
            "type": "string",
            "nullable": true
          },
          "condition": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "MAINTENANCE"
            ]
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "borrowed": {
            "type": "boolean"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "assetTag",
          "condition",
          "notes",
          "borrowed",
          "imageUrl"
        ]
      },
      "CreatedLoan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "equipmentId": {
            "type": "string",
            "format": "uuid"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "equipmentId",
          "dueAt"
        ]
      },
      "OpenLoan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "equipment": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "assetTag": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "id",
              "name",
              "assetTag"
            ]
          }
        },
        "required": [
          "id",
          "dueAt",
          "equipment"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
